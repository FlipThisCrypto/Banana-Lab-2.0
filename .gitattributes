# =============================================================================
# Banana Lab 2.0 — attributes
#
# Git LFS is intentionally NOT enabled. Rationale and the conditions that would
# change that decision are recorded in docs/architecture/ASSET_VERSIONING_POLICY.md.
# =============================================================================

# Normalise text line endings in the repository, check out native on Windows.
* text=auto

# Explicit text types
*.md        text
*.yaml      text
*.yml       text
*.json      text
*.csv       text
*.py        text
*.toml      text
*.cfg       text
*.ini       text
*.txt       text
*.html      text
*.css       text
*.js        text

# Shell scripts must keep LF or they will not run under bash.
*.sh        text eol=lf
# PowerShell scripts keep CRLF.
*.ps1       text eol=crlf

# Binary assets — never diff, never line-ending-convert.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.pdf       binary
*.zip       binary
*.cbz       binary
*.psd       binary
*.kra       binary
*.safetensors binary
*.ckpt      binary

# Generated manifests: keep diffs readable but do not treat conflicts as trivial.
source_material/manifests/*.csv  text merge=union
